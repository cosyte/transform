{
  "name": "@cosyte/transform",
  "version": "0.1.3",
  "description": "HL7 v2 → FHIR R4 transformation library for Node.js and TypeScript: IG-grounded, fail-safe, value-free diagnostics; never a confident wrong FHIR value.",
  "keywords": [
    "hl7",
    "hl7v2",
    "fhir",
    "fhir-r4",
    "transform",
    "v2-to-fhir",
    "mapping",
    "adt",
    "oru",
    "healthcare",
    "interoperability",
    "typescript"
  ],
  "homepage": "https://docs.cosyte.com/transform",
  "bugs": {
    "url": "https://github.com/cosyte/transform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/transform.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "peerDependencies": {
    "@cosyte/fhir": "^0.1.0",
    "@cosyte/hl7": "^0.1.0"
  },
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "conformance": "tsx scripts/conformance/run.ts",
    "check:no-internal-refs": "bash scripts/check-no-internal-refs.sh",
    "check:no-emdash": "node scripts/check-no-emdash.mjs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"examples/**/*.{ts,js,json,md}\" \"*.{json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"examples/**/*.{ts,js,json,md}\" \"*.{json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "attw": "cosyte-attw",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "eslint examples --max-warnings=0",
    "phi-scan:examples": "tsx scripts/phi-scan.ts examples/*.ts",
    "version": "changeset version && node scripts/sync-version.mjs && prettier --write package.json CHANGELOG.md src/index.ts",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1.1",
    "@cosyte/fhir": "^0.1.0",
    "@cosyte/hl7": "^0.1.0",
    "@cosyte/prettier-config": "^0.1.1",
    "@cosyte/script-utils": "^0.1.5",
    "@cosyte/test-utils": "^0.1.1",
    "@cosyte/tsconfig": "^0.1.1",
    "@cosyte/tsup-config": "^0.1.1",
    "@cosyte/vitest-config": "^0.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.5.0",
    "fast-check": "3.23.2",
    "prettier": "3.8.3",
    "simple-git-hooks": "2.13.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {}
}
