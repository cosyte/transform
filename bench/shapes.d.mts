// Types for bench/shapes.mjs, so the scaling gate under test/perf builds its inputs from the same
// code the benchmarks do.

/** 1024. */
export declare const KIB: number;
/** One segment, each value at its 1-indexed field position. */
export declare function seg(name: string, fields: Readonly<Record<number, string>>): string;
/** A synthetic ADT^A01 admission of 15 segments, about 1 KiB. */
export declare function admission(i: number): string;
/** A synthetic HL7 batch file (FHS, BHS, the messages, BTS, FTS) of `messages` admissions. */
export declare function admissionBatch(i: number, messages: number): string;
/** A synthetic ORU^R01 lab result of `results` OBX lines. */
export declare function labResult(i: number, results: number): string;
/** A synthetic MDM^T02 whose note is `lines` OBX lines of type TX. */
export declare function longNote(i: number, lines: number): string;
/** `bytes` generated bytes, base64. */
export declare function base64Document(bytes: number, seed: number): string;
/** A synthetic ORU^R01 carrying one base64 PDF of `bytes` bytes in an OBX of type ED. */
export declare function reportWithPdf(i: number, bytes: number): string;
/** A synthetic searchset Bundle of `entries` Observations as JSON text, one entry a line. */
export declare function observationBundle(i: number, entries: number): string;
/** A synthetic Patient as JSON text. */
export declare function patientJson(i: number): string;
/** The namespace mnemonics the synthetic messages use, as `createNamingSystem` takes them. */
export declare const AUTHORITIES: {
  readonly authorities: Readonly<Record<string, string>>;
  readonly codeSystems: Readonly<Record<string, string>>;
};
/** The reverse path's options. */
export declare const REVERSE_OPTIONS: {
  readonly assigningAuthorities: Readonly<Record<string, string>>;
  readonly envelope: { readonly sendingApp: string; readonly sendingFacility: string };
};
